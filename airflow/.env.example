# Copy this file to airflow/.env (git-ignored) and fill in the values.
# Never commit the real .env.

AIRFLOW_UID=50000

# S3
LANDING_BUCKET=gilang-clickstream-project2

# Snowflake (account looks like ORGNAME-ACCOUNTNAME, shown in Snowsight under your account menu)
SNOWFLAKE_ACCOUNT=<orgname-accountname>
# Folder on YOUR PC that holds rsa_key.p8 (use forward slashes); mounted read-only at /opt/airflow/keys
SNOWFLAKE_KEY_DIR=C:/Users/ASUS/.snowflake
# Path INSIDE the containers (leave as is)
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/rsa_key.p8

# Airflow connections, read from environment variables (nothing typed into the UI)
AIRFLOW_CONN_AWS_DEFAULT='{"conn_type": "aws", "login": "<uploader access key id>", "password": "<uploader secret>", "extra": {"region_name": "ap-southeast-2"}}'
AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type": "snowflake", "login": "PIPELINE_SVC", "schema": "RAW", "extra": {"account": "<orgname-accountname>", "warehouse": "CLICKSTREAM_WH", "database": "CLICKSTREAM", "role": "TRANSFORMER", "private_key_file": "/opt/airflow/keys/rsa_key.p8"}}'
